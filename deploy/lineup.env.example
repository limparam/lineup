# /etc/lineup/lineup.env — окружение приложения.
# Права: chown root:lineup, chmod 640.

# База SQLite. Каталог должен быть доступен на запись пользователю lineup.
LINEUP_DB=/var/lib/lineup/lineup.db

# Приложение за nginx: доверяем X-Forwarded-* и ставим Secure-cookie.
LINEUP_TRUST_PROXY=1
LINEUP_COOKIE_SECURE=1

# Время жизни сессии админки (часы).
LINEUP_SESSION_HOURS=12

# Защита от перебора: N неудач за окно (сек) на IP / на логин.
LINEUP_LOGIN_MAX_FAILURES=10
LINEUP_LOGIN_MAX_USER_FAILURES=20
LINEUP_LOGIN_WINDOW=900

# Статику в продакшене отдаёт nginx, значение ниже не важно.
# LINEUP_ASSET_CACHE=public, max-age=86400
